          "status"
        ]
      },
      {
        "from": "Inactive",
        "to": "Active",
        "trigger": "RestoreAccount",
        "condition": "管理员恢复",
        "variablesChanged": [
          "status"
        ]
      }
    ],
    "initializations": [
      {
        "trigger": "ProvisionAccount",
        "state": "Active",
        "condition": "账号开通时默认在用"
      }
    ],
    "sourceUserStoryIds": [
      "US-OR-001"
    ]
  },
