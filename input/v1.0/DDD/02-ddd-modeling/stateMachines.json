[
  {
    "id": "SM-AppointmentStatus",
    "ownerAggregate": "VisitAppointment",
    "targetClass": "VisitAppointment",
    "stateField": "status",
    "states": [
      {
        "name": "Pending",
        "isInitial": true,
        "isTerminal": false,
        "value": "待审核"
      },
      {
        "name": "Approved",
        "isInitial": false,
        "isTerminal": false,
        "value": "已通过"
      },
      {
        "name": "Rejected",
        "isInitial": false,
        "isTerminal": true,
        "value": "已拒绝"
      },
      {
        "name": "Rescheduled",
        "isInitial": false,
        "isTerminal": false,
        "value": "已改期"
      },
      {
        "name": "Expired",
        "isInitial": false,
        "isTerminal": true,
        "value": "已过期"
      },
      {
        "name": "InSchool",
        "isInitial": true,
        "isTerminal": false,
        "value": "已到访(在校中)"
      },
      {
        "name": "Left",
        "isInitial": false,
        "isTerminal": false,
        "value": "已离校"
      },
      {
        "name": "Cancelled",
        "isInitial": false,
        "isTerminal": true,
        "value": "已取消"
      }
    ],
    "transitions": [
      {
        "from": "Pending",
        "to": "Approved",
        "trigger": "ApproveAppointment",
        "condition": "待审核预约审核同意",
        "variablesChanged": [
          "status"
        ]
      },
      {
        "from": "Rescheduled",
        "to": "Approved",
        "trigger": "ApproveAppointment",
        "condition": "改期预约审核同意",
        "variablesChanged": [
          "status"
        ]
      },
      {
        "from": "Pending",
        "to": "Rejected",
        "trigger": "RejectAppointment",
        "condition": "拒绝原因符合规则",
        "variablesChanged": [
          "status"
        ]
      },
      {
        "from": "Rescheduled",
        "to": "Rejected",
        "trigger": "RejectAppointment",
        "condition": "改期预约被拒绝",
        "variablesChanged": [
          "status"
        ]
      },
      {
        "from": "Pending",
        "to": "Rescheduled",
        "trigger": "ReviewRescheduleAppointment",
        "condition": "审核人给出新时段且校验通过",
        "variablesChanged": [
          "status",
          "visitWindow"
        ]
      },
      {
        "from": "Pending",
        "to": "Rescheduled",
        "trigger": "RescheduleAppointment",
        "condition": "到访前由有权主体改期",
        "variablesChanged": [
          "status",
          "visitWindow"
        ]
      },
      {
        "from": "Approved",
        "to": "Rescheduled",
        "trigger": "RescheduleAppointment",
        "condition": "已通过但尚未到访且新时段校验通过",
        "variablesChanged": [
          "status",
          "visitWindow"
        ]
      },
      {
        "from": "Rescheduled",
        "to": "Rescheduled",
        "trigger": "RescheduleAppointment",
        "condition": "再次改期且新时段校验通过",
        "variablesChanged": [
          "visitWindow"
        ]
      },
      {
        "from": "Pending",
        "to": "Expired",
        "trigger": "ExpireAppointment",
        "condition": "超出时段仍未核验",
        "variablesChanged": [
          "status"
        ]
      },
      {
        "from": "Approved",
        "to": "Expired",
        "trigger": "ExpireAppointment",
        "condition": "超出时段仍未核验",
        "variablesChanged": [
          "status"
        ]
      },
      {
        "from": "Rescheduled",
        "to": "Expired",
        "trigger": "ExpireAppointment",
        "condition": "改期后超时未核验或未确认",
        "variablesChanged": [
          "status"
        ]
      },
      {
        "from": "Approved",
        "to": "InSchool",
        "trigger": "AdmitVisitor",
        "condition": "核验通过并登记进校",
        "variablesChanged": [
          "status",
          "lastPassageAt"
        ]
      },
      {
        "from": "Left",
        "to": "InSchool",
        "trigger": "AdmitVisitor",
        "condition": "同一自然日再次核验进校",
        "variablesChanged": [
          "status",
          "lastPassageAt"
        ]
      },
      {
        "from": "InSchool",
        "to": "Left",
        "trigger": "RecordDeparture",
        "condition": "门卫登记离校",
        "variablesChanged": [
          "status",
          "lastPassageAt"
        ]
      },
      {
        "from": "Pending",
        "to": "Cancelled",
        "trigger": "CancelAppointment",
        "condition": "到访前有权主体取消",
        "variablesChanged": [
          "status"
        ]
      },
      {
        "from": "Approved",
        "to": "Cancelled",
        "trigger": "CancelAppointment",
        "condition": "已通过但尚未到访时取消",
        "variablesChanged": [
          "status"
        ]
      },
      {
        "from": "Rescheduled",
        "to": "Cancelled",
        "trigger": "CancelAppointment",
        "condition": "改期后尚未到访时取消",
        "variablesChanged": [
          "status"
        ]
      }
    ],
    "initializations": [
      {
        "trigger": "SubmitAppointment",
        "state": "Pending",
        "condition": "线上或后台代提通过校验后创建"
      },
      {
        "trigger": "RegisterWalkIn",
        "state": "InSchool",
        "condition": "无预约现场登记并放行后创建"
      }
    ],
    "sourceUserStoryIds": [
      "US-AP-004",
      "US-AP-005",
      "US-AP-006",
      "US-AT-002",
      "US-GV-002",
      "US-GV-003",
      "US-GV-005"
    ]
  },
  {
    "id": "SM-VisitCredentialUsage",
    "ownerAggregate": "VisitAppointment",
    "targetClass": "VisitCredential",
    "stateField": "usageStatus",
    "states": [
      {
        "name": "Unused",
        "isInitial": true,
        "isTerminal": false,
        "value": "unused"
      },
      {
        "name": "Used",
        "isInitial": false,
        "isTerminal": true,
        "value": "used"
      }
    ],
    "transitions": [
      {
        "from": "Unused",
        "to": "Used",
        "trigger": "RedeemVisitCredential",
        "condition": "首次有效凭证核销",
        "variablesChanged": [
          "usageStatus",
          "redeemedAt"
        ]
      }
    ],
    "initializations": [
      {
        "trigger": "SubmitAppointment",
        "state": "Unused",
        "condition": "预约提交时生成凭证"
      }
    ],
    "sourceUserStoryIds": [
      "US-GV-004"
    ]
  },
  {
    "id": "SM-AccountStatus",
