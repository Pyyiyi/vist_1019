    "invariants": [
      {
        "description": "停用或锁定账号不得登录；失败计数与锁定窗口按账号维护。",
        "triggerCommandRefs": [
          "AuthenticateUser",
          "ProvisionAccount",
          "DisableAccount",
          "RestoreAccount"
